{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unwrap",
  "version": "0.1.0",
  "identifier": "com.unwrap.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unwrap",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/AssetRipper",
      "binaries/ilspycmd"
    ],
    "resources": [
      "NOTICE.txt"
    ]
  }
}
